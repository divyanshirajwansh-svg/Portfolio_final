# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Never commit real secrets or private API keys to GitHub!
# For local serverless testing or deployment on Vercel, set these in Vercel Dashboard
# ==============================================================================

# Option 1: Google Gemini API (Recommended for Google Deepmind/Gemini class demonstrations)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI API (Alternative AI provider)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Generic key alias
CHATBOT_API_KEY=
